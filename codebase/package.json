{
  "name": "myviuni-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "ingest": "node scripts/ingest-documents.mjs",
    "predev": "npm run ingest",
    "dev": "vite",
    "prebuild": "npm run ingest",
    "build": "tsc -b && vite build && vite build --ssr server/render.ts --outDir dist-server",
    "start": "node dist-server/render.js",
    "smoke:render": "node scripts/smoke-render.mjs",
    "verify:public-source": "node scripts/verify-public-source.mjs",
    "preview": "vite preview",
    "pretest": "npm run ingest",
    "test": "vitest run && node --test scripts/ingest-documents.node-test.mjs",
    "preeval": "npm run ingest",
    "eval": "vitest run eval/handbook.test.ts",
    "eval:live": "npm run ingest && vite-node scripts/run-eval.ts",
    "test:e2e": "playwright test",
    "pretypecheck": "npm run ingest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.56",
    "ai": "^7.0.105",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
